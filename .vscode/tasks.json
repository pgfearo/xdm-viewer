{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "xslt",
			"label": "run xdm-viewer HTML example",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/examples/demo.xsl",
			"xmlSource": "${workspaceFolder}/examples/demo.xsl",
			"initialTemplate": "",
			"resultPath": "${workspaceFolder}/examples/out/empty.xml",
			"allowSyntaxExtensions40": "off",
			"parameters": [{"name": "mode", "value": "write"}],
			"messageEscaping": "adaptive",
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$saxon-xslt"
			]
		},
		{
			"type": "xslt",
			"label": "run xdm-viewer HTML example (refs)",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/examples/demo-refs.xsl",
			"xmlSource": "${workspaceFolder}/examples/demo-refs.xsl",
			"initialTemplate": "",
			"resultPath": "${workspaceFolder}/examples/out/empty.xml",
			"allowSyntaxExtensions40": "off",
			"parameters": [{"name": "mode", "value": "write"}],
			"messageEscaping": "adaptive",
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$saxon-xslt"
			]
		},
		{
			"type": "xslt",
			"label": "run xdm-tokens example",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/examples/demo-tokens.xsl",
			"xmlSource": "${workspaceFolder}/examples/demo-tokens.xsl",
			"initialTemplate": "",
			"resultPath": "${workspaceFolder}/examples/out/empty.xml",
			"allowSyntaxExtensions40": "off",
			"parameters": [{"name": "mode", "value": "write"}],
			"messageEscaping": "adaptive",
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$saxon-xslt"
			]
		},
	]
}